  "historical_document": {
    "title_de": "Bürgerbrief für den Kaufmann Michael Ephraim Lehmann",
    "title_en": "Citizenship Certificate for the Merchant Michael Ephraim Lehmann",
    "date": "1815-04-17",
    "location": "Wrietzen a/O",
    "seal_stamp": "Acht G. Groschen",
    "content_de": "Der Magistrat der Königl. Preuss. Stadt Wrietzen a/O thut kund und bekennt hierdurch, dass der jüdische Kaufmann Michael Ephraim Lehmann, nachdem er die nöthigen Erfordernisse nachgewiesen hat, seinem Ansuchen gemäss zum Bürger hiesiger Stadt angenommen worden ist...",
    "content_en": "The Magistrate of the Royal Prussian City of Wrietzen on the Oder hereby makes known and acknowledges that the Jewish merchant Michael Ephraim Lehmann, having demonstrated the necessary requirements, has been accepted as a citizen of this city in accordance with his request..."
  }
